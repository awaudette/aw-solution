rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function meExists() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function active() { return meExists() && me().get('statut', '') != 'revoque'; }
    function myRole() { return meExists() ? me().role : null; }
    function myClientId() { return meExists() ? me().get('clientId', null) : null; }
    function isStaff() { return active() && myRole() in ['admin', 'employe']; }
    function isAdmin() { return active() && myRole() == 'admin'; }
    function isOwnClient(clientId) {
      return active() && myRole() == 'client' && myClientId() == clientId;
    }

    match /clients/{clientId}/branding/{allPaths=**} {
      allow read, write: if isStaff() || isOwnClient(clientId);
    }
    match /clients/{clientId}/journal/{allPaths=**} {
      allow read: if isStaff() || isOwnClient(clientId);
      allow write: if isStaff();
    }
    // Pièces jointes — Messagerie (clients/{clientId}/fichiers-joints/messages/…)
    // et demandes de modification du journal
    // (clients/{clientId}/fichiers-joints/journal-retours/{entryId}/…).
    // Tout type de fichier, 25 Mo maximum par fichier. Suppression : auteur du
    // fichier (customMetadata.uploaderUid posé au téléversement, voir
    // src/lib/attachments.ts) ou admin — couvre "auteur peut supprimer le
    // sien", "employé seulement les siens", "admin n'importe lequel".
    match /clients/{clientId}/fichiers-joints/{allPaths=**} {
      allow read: if isStaff() || isOwnClient(clientId);
      allow create: if (isStaff() || isOwnClient(clientId))
                    && request.resource.size <= 25 * 1024 * 1024
                    && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isAdmin() || (active() && resource.metadata.uploaderUid == request.auth.uid);
    }
    match /contrats/{clientId}/{allPaths=**} {
      allow read: if isStaff() || isOwnClient(clientId);
      allow write: if isStaff();
    }

    // logos/ (logo AW Solution) et templates/ (vidéos de présentation) : URLs
    // déjà émises et codées en dur (token inclus) dans le code, jamais lues
    // via getDownloadURL() du SDK — aucune règle nécessaire, pas de match =>
    // refusé pour tout accès SDK, ce qui n'affecte pas ces URLs déjà émises.
  }
}
