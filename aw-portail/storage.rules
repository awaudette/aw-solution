rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function meExists() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function active() { return meExists() && me().get('statut', '') != 'revoque'; }
    function myRole() { return meExists() ? me().role : null; }
    function myClientId() { return meExists() ? me().get('clientId', null) : null; }
    function isStaff() { return active() && myRole() in ['admin', 'employe']; }
    function isOwnClient(clientId) {
      return active() && myRole() == 'client' && myClientId() == clientId;
    }

    match /clients/{clientId}/branding/{allPaths=**} {
      allow read, write: if isStaff() || isOwnClient(clientId);
    }
    match /clients/{clientId}/journal/{allPaths=**} {
      allow read: if isStaff() || isOwnClient(clientId);
      allow write: if isStaff();
    }
    match /contrats/{clientId}/{allPaths=**} {
      allow read: if isStaff() || isOwnClient(clientId);
      allow write: if isStaff();
    }

    // logos/ (logo AW Solution) et templates/ (vidéos de présentation) : URLs
    // déjà émises et codées en dur (token inclus) dans le code, jamais lues
    // via getDownloadURL() du SDK — aucune règle nécessaire, pas de match =>
    // refusé pour tout accès SDK, ce qui n'affecte pas ces URLs déjà émises.
  }
}
